      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (node) (rate(tenxgraph_node_errors_total{job=~\"$job\"}[$__rate_interval]))",
