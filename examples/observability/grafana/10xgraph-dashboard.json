      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, task) (rate(tenxgraph_task_duration_milliseconds_bucket{job=~\"$job\", task=~\"$task\"}[$__rate_interval])))",
          "legendFormat": "{{task}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
